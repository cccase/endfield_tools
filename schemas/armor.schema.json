{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArmorData",
  "type": "object",
  "required": ["id", "name", "part", "rarity"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "part": {
      "type": "string",
      "enum": ["body", "arms", "accessories"]
    },
    "rarity": { "type": "integer", "minimum": 4, "maximum": 6 },
    "setId": { "type": ["string", "null"] },
    "mainStat": {
      "type": "object",
      "required": ["stat", "value"],
      "properties": {
        "stat": { "type": "string" },
        "value": { "type": "number" }
      }
    },
    "subStats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stat", "value"],
        "properties": {
          "stat": { "type": "string" },
          "value": { "type": "number" }
        }
      }
    },
    "ultEfficiency": { "type": "number" }
  }
}

