{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CharacterData",
  "type": "object",
  "required": [
    "id",
    "name",
    "rarity",
    "element",
    "weaponType",
    "class",
    "mainStat",
    "subStat",
    "baseStats",
    "skills"
  ],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "icon": { "type": "string" },
    "rarity": { "type": "integer", "minimum": 4, "maximum": 6 },
    "element": {
      "type": "string",
      "enum": ["物理", "灼熱", "電磁", "寒冷", "自然"]
    },
    "weaponType": {
      "type": "string",
      "enum": ["片手剣", "大剣", "長柄武器", "拳銃", "アーツユニット"]
    },
    "class": {
      "type": "string",
      "enum": ["前衛", "先鋒", "重装", "術師", "突撃", "補助"]
    },
    "mainStat": {
      "type": "string",
      "enum": ["筋力", "敏捷", "知性", "意志"]
    },
    "subStat": {
      "type": "string",
      "enum": ["筋力", "敏捷", "知性", "意志"]
    },
    "baseStats": {
      "type": "object",
      "required": ["hp", "atk", "strength", "agility", "intellect", "willpower"],
      "properties": {
        "hp": { "type": "number", "minimum": 0 },
        "atk": { "type": "number", "minimum": 0 },
        "strength": { "type": "number", "minimum": 0 },
        "agility": { "type": "number", "minimum": 0 },
        "intellect": { "type": "number", "minimum": 0 },
        "willpower": { "type": "number", "minimum": 0 },
        "artsIntensity": { "type": "number", "minimum": 0 },
        "critRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "critDamage": { "type": "number", "minimum": 0 }
      }
    },
    "defaultEfficiency": { "type": "number" },
    "defaultPotential": { "type": "integer" },
    "baseRefundSP": { "type": "number" },
    "potentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["level", "type"],
        "properties": {
          "level": { "type": "integer" },
          "type": { "type": "string" },
          "value": { "type": "number" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "target": {
            "type": "string",
            "enum": ["self", "single", "team", "others", "enemy", "none"]
          },
          "targetLabel": { "type": "string" },
          "calcGroup": { "type": "string" },
          "calcGroupLabel": { "type": "string" },
          "special": { "type": ["string", "null"] }
        }
      }
    },
    "talents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "target": {
            "type": "string",
            "enum": ["self", "single", "team", "others", "enemy", "none"]
          },
          "targetLabel": { "type": "string" },
          "calcGroup": { "type": "string" },
          "calcGroupLabel": { "type": "string" },
          "special": { "type": ["string", "null"] },
          "buffs": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "normalAttack": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "damageType": { "type": "string" },
        "attach": { "type": "string" },
        "multipliers": { "type": "string" },
        "breakValue": { "type": "string" },
        "description": { "type": "string" },
        "raw": { "type": "string" }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "damageType", "multipliers"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["skill", "skill2", "skill3", "combo", "ult", "ult2", "ult_cancel", "other"]
          },
          "name": { "type": "string" },
          "shortName": { "type": "string" },
          "spCost": { "type": "number" },
          "epCost": { "type": "number" },
          "damageType": {
            "type": "string",
            "enum": ["物理", "灼熱", "電磁", "寒冷", "自然", "なし"]
          },
          "infliction": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["none", "heat", "cryo", "electric", "nature", "copy_slot1", "okugi_dual"] },
              "stacks": { "type": "integer", "minimum": 0, "maximum": 4 },
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "crush": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["none", "inflict", "consume_smash", "consume_shatter"] },
              "stacks": { "type": "integer", "minimum": 0, "maximum": 4 },
              "label": { "type": "string" },
              "description": { "type": "string" }
            }
          },
          "multipliers": {
            "type": "object",
            "required": ["lv9", "lv10_spec1", "lv11_spec2", "lv12_spec3"],
            "properties": {
              "lv9": { "type": "number", "minimum": 0 },
              "lv10_spec1": { "type": "number", "minimum": 0 },
              "lv11_spec2": { "type": "number", "minimum": 0 },
              "lv12_spec3": { "type": "number", "minimum": 0 }
            }
          },
          "description": { "type": "string" },
          "special": { "type": ["string", "null"] },
          "rawText": { "type": "string" },
          "attachText": { "type": "string" },
          "anomalyText": { "type": "string" },
          "hitCount": { "type": "integer", "minimum": 1 },
          "buffs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "target"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "target": {
                  "type": "string",
                  "enum": ["self", "single", "team", "others", "enemy", "none"]
                },
                "targetLabel": { "type": "string" },
                "category": {
                  "type": "string",
                  "enum": ["buff", "debuff", "special", "aux"]
                },
                "stat": { "type": "string" },
                "value": { "type": "number" },
                "duration": { "type": "number" },
                "description": { "type": "string" },
                "calcGroup": { "type": "string" },
                "calcGroupLabel": { "type": "string" },
                "maxStacks": { "type": "integer" },
                "isStackable": { "type": "boolean" },
                "special": { "type": ["string", "null"] }
              }
            }
          }
        }
      }
    },
    "motifWeapon": { "type": ["string", "null"] },
    "specialMechanic": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["copy_slot1", "okugi_dual", "custom"] },
        "description": { "type": "string" }
      }
    },
    "recommendedWeapons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendedArmorSet": {
      "type": ["string", "null"]
    },
    "recommendedArmorSetName": {
      "type": ["string", "null"]
    },
    "recommendedArmor": {
      "type": "object",
      "properties": {
        "armorSet": { "type": "string" },
        "body": { "type": "string" },
        "arm": { "type": "string" },
        "acc1": { "type": "string" },
        "acc2": { "type": "string" }
      }
    }
  }
}

