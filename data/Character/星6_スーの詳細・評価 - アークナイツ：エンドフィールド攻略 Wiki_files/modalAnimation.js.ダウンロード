(function() {

    'use strict';

    var NGIDs;
    var AboneMode;
    load();

    // scope を渡すとその範囲だけを初期化する (pcrt の追加読み込み用)。
    // scope には li 要素そのもの、要素の配列、親要素のいずれも渡せる。
    // 省略時は従来どおりページ全体。
    function initComments(scope) {
        var comments;
        if (!scope) {
            comments = document.querySelectorAll("ul.list1 li");
        } else if (scope.nodeType !== 1) {
            comments = scope;                       // 配列 / NodeList
        } else if (scope.tagName === "LI") {
            comments = [scope];                     // li 自身 (子孫検索では拾えない)
        } else {
            comments = scope.querySelectorAll("li");
        }
        // IP由来ID(11文字) と LINE ID([LINE:8文字]) をそれぞれ拾う
        var regexId   = new RegExp('\\[' + '([0-9a-zA-Z\\.\\/]{11})' + '\\]', 'gm');
        var regexLine = new RegExp('\\[LINE:' + '([0-9a-z]{8})' + '\\]', 'gm');
        var i=0, len;
        var elem, tmpHtml;

        for(i=0,len=comments.length; i<len; i++) {
            tmpHtml = "";
            for(elem of comments[i].childNodes) {
                if(elem.nodeName == "#text") {
                    tmpHtml += elem.nodeValue.replace(/</g, "&lt;").replace(/>/g, "&gt;");
                    elem.nodeValue = "";

                }else if(elem.nodeName == "INPUT" || elem.nodeName == "BR") {
                    tmpHtml += elem.outerHTML;
                    elem.classList.add("js-remove");

                }else if(elem.nodeName == "SPAN" || elem.nodeName == "A" || elem.nodeName == "STRONG" || elem.nodeName == "DEL" || elem.nodeName == "INS" || elem.nodeName == "EM") {
                    tmpHtml += elem.outerHTML;
                    elem.classList.add("js-remove");
                }
            }

            // このコメントに出現したIDを、IP由来とLINEに分けて収集
            var ipIds = [], lineIds = [], m;
            regexId.lastIndex = 0;
            while((m = regexId.exec(tmpHtml)) !== null) ipIds.push(m[1]);
            regexLine.lastIndex = 0;
            while((m = regexLine.exec(tmpHtml)) !== null) lineIds.push(m[1]);
            var ids = ipIds.concat(lineIds);

            // リンク化: IP由来IDは従来どおり。LINE IDは data-idtype='line' を付与
            tmpHtml = tmpHtml.replace(regexId,
                "[<span class='js-abonelinkwrap'><a href='javascript:void(0);' class='js-abonelink' data-userid='$1'>$1</a></span>]");
            tmpHtml = tmpHtml.replace(regexLine,
                "[<span class='js-abonelinkwrap'><a href='javascript:void(0);' class='js-abonelink' data-idtype='line' data-userid='$1'>LINE:$1</a></span>]");

            // 代表ID(data-userid): 従来互換のため「最後のIP由来ID」を維持。
            // IP由来が無いコメント(LINEのみ等)は最後のIDにフォールバック。
            var primary = "undefined";
            if (ipIds.length > 0)      primary = ipIds[ipIds.length-1];
            else if (ids.length > 0)   primary = ids[ids.length-1];

            comments[i].insertAdjacentHTML("afterbegin",
                "<span class='js-comment' data-userid='"+ primary +"' data-userids='"+ ids.join(",") +"'>"+ tmpHtml +"</span>");
        }

        // 対象コメントの中だけを見る (scope 指定時に取りこぼさないため)
        var aboneLinks = [], oldNodes = [], k, sub;
        for(i=0,len=comments.length; i<len; i++) {
            sub = comments[i].querySelectorAll("a.js-abonelink");
            for(k=0; k<sub.length; k++) aboneLinks.push(sub[k]);
            sub = comments[i].querySelectorAll(".js-remove");
            for(k=0; k<sub.length; k++) oldNodes.push(sub[k]);
        }
        for(i=0,len=aboneLinks.length; i<len; i++) {
            aboneLinks[i].addEventListener("click", showAboneLinkMenu, false);
        }
        for(i=0,len=oldNodes.length; i<len; i++) {
            if(oldNodes[i].parentNode) oldNodes[i].parentNode.removeChild(oldNodes[i]);
        }
        abone();
    }

