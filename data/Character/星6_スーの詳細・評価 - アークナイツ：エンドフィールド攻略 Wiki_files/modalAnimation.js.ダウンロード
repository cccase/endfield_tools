    function setAboneMode(mode) {
        document.body.classList.remove("js-sabori","js-hide","js-rensa","js-gray","js-white");
        switch(mode) {
            case "normal":
                break;
            case "sabori":
                document.body.classList.add("js-sabori");
                break;
            case "gray":
                document.body.classList.add("js-sabori","js-gray");
                break;
            case "white":
                document.body.classList.add("js-sabori","js-white");
                break;
            case "hide":
                document.body.classList.add("js-hide");
                break;
            case "rensa":
                document.body.classList.add("js-rensa");
                break;
            case "rensahide":
                document.body.classList.add("js-rensa","js-hide");
                break;
            default:
                break;
        }
        AboneMode = mode;
        save();
    }

    var currentPage = 0;
    var PAGE_SIZE   = 10;

    function printList() {
        var table = document.querySelector(".js-listtable");
        var pager = document.querySelector(".js-pagination");
        var tmpHtml = "";
        var i=0, len;
        var totalPages = Math.max(1, Math.ceil(NGIDs.length / PAGE_SIZE));
        if (currentPage >= totalPages) currentPage = Math.max(0, totalPages - 1);
        var start = currentPage * PAGE_SIZE;
        var end   = Math.min(start + PAGE_SIZE, NGIDs.length);

        for (i = start; i < end; i++) {
            // 表示だけ接頭辞を復元(保存値は接頭辞なし)。
            // LINE IDは8文字[0-9a-z]、IP由来IDは11文字なので長さで判別できる。
            var disp = /^[0-9a-z]{8}$/.test(NGIDs[i]) ? ("LINE:" + NGIDs[i]) : NGIDs[i];
            tmpHtml += ""+
                "<div class='js-listrow'>"+
                    "<div class='js-listcell'>"+
                        disp+
                    "</div>"+
                    "<div class='js-listcell'>"+
                        "<a href='javascript:void(0);' class='js-listbtn' data-userid='"+ NGIDs[i] +"'>×</a>"+
                    "</div>"+
                "</div>";
        }
        table.innerHTML = tmpHtml;

        var removeLinks = document.querySelectorAll("a.js-listbtn");
        for (i = 0, len = removeLinks.length; i < len; i++) {
            removeLinks[i].addEventListener("click", clickRemoveLinkEvent, false);
        }

        // ページネーションUI（pagerは常にDOM上に存在する）
        if (!pager) return;
        if (NGIDs.length <= PAGE_SIZE) {
            pager.style.display = "none";
            return;
        }
        pager.style.display = "flex";
        pager.innerHTML =
            "<button class='js-pg-prev'" + (currentPage === 0 ? " disabled" : "") + ">◀ 前へ</button>"+
            "<span>" + (currentPage + 1) + " / " + totalPages + "ページ</span>"+
            "<button class='js-pg-next'" + (currentPage >= totalPages - 1 ? " disabled" : "") + ">次へ ▶</button>";

        pager.querySelector(".js-pg-prev").addEventListener("click", function(e) {
            e.stopPropagation();
            if (currentPage > 0) { currentPage--; printList(); }
        });
        pager.querySelector(".js-pg-next").addEventListener("click", function(e) {
            e.stopPropagation();
            if (currentPage < totalPages - 1) { currentPage++; printList(); }
        });
    }

    function clickAddLinkEvent(ev) {
        var userid = ev.target.dataset.userid;
        var ans = window.confirm(userid +" をNGIDに追加します。よろしいですか？");
        if(ans){
            addNgid(userid);
        }
    }

    function clickRemoveLinkEvent(ev) {
        var userid = ev.target.dataset.userid;
        var ans = window.confirm(userid +" をNGIDから削除します。よろしいですか？");
        if(ans){
            removeNgid(userid);
        }
    }

    function clickSearchLinkEvent(ev) {
        var userId = ev.target.dataset.userid;
        var copyResult = clipboard(userId);
        console.log("copy: "+copyResult);

        var form = document.createElement("form");
        form.setAttribute("action", "https://" + window.location.hostname + "/index.php?cmd=search");
        form.setAttribute("method","post");
        form.setAttribute("target","_blank");
        form.style.position = "fixed";
        form.style.left = "-100%";

        var encode_hint = document.createElement("input");
        encode_hint.setAttribute("type","hidden");
        encode_hint.setAttribute("name","encode_hint");
        encode_hint.setAttribute("value","ぷ");
        form.appendChild(encode_hint);

        var word = document.createElement("input");
        word.setAttribute("type","hidden");
        word.setAttribute("name","word");
        word.setAttribute("value",userId);
        form.appendChild(word);

var type = document.createElement("input");
        type.setAttribute("type","hidden");
        type.setAttribute("name","type");
        type.setAttribute("value","AND");
        form.appendChild(type);

        document.body.appendChild(form);
        form.submit();
        document.body.removeChild(form);
    }

    function clipboard(str) {
        var div = document.createElement("div");
        div.appendChild(document.createElement("pre")).textContent = str;
        div.style.position = "fixed";
        div.style.left = "-100%";
        document.body.appendChild(div);
        document.getSelection().selectAllChildren(div);
        var result = document.execCommand('copy');
        document.body.removeChild(div);
        return result;
    }

    function showAboneLinkMenu(ev) {
        if(!ev.target.parentNode.querySelector(".js-abonelinkmenu")) {
            var idLink = ev.target;
            var idLinkWrap = ev.target.parentNode;
            var userId = ev.target.dataset.userid;              // 値は接頭辞なし(例: nc0lcj98)
            var isLine = (ev.target.dataset.idtype === "line");
            var abLabel = isLine ? "NGIDに登録(LINE)" : "NGIDに登録";
            var str = ""+
                "<ul class='js-abonelinkmenu'>"+
                "<li><a href='javascript:void(0);' class='js-itemabone' data-userid='"+userId+"'>"+abLabel+"</a></li>"+
                "<li><a href='javascript:void(0);' class='js-itemsearch' data-userid='"+userId+"'>コピーして検索</a></li>"+
                "</ul>";
            idLink.insertAdjacentHTML("afterend",str);

            var itemAbone = idLinkWrap.querySelector(".js-itemabone");
            var itemSearch = idLinkWrap.querySelector(".js-itemsearch");
            itemAbone.addEventListener("click",clickAddLinkEvent,false);
            itemSearch.addEventListener("click",clickSearchLinkEvent,false);
        }
    }

    function hideAboneLinkMenu(ev) {
        if( ev.target.parentNode.classList.contains(".js-abonelinkmenu") ||
           ev.target.classList.contains(".js-itemabone") ||
           ev.target.classList.contains(".js-itemsearch") ) return false;
        var menus = document.querySelectorAll(".js-abonelinkmenu");
        for(var i=0,len=menus.length; i<len; i++) {
            menus[i].parentNode.removeChild(menus[i]);
        }
    }

    function initBodyClick(){
        document.body.addEventListener("click",hideAboneLinkMenu,true);
    }

    function addNgid(userid) {
        NGIDs.unshift(userid);
        NGIDs = NGIDs.filter(function (x, i, self) {
            return self.indexOf(x) === i;
        });
        save();
        printList();
        abone();
    }

    function removeNgid(userid) {
        NGIDs = NGIDs.filter(function(v){
            return v != userid;
        });
        save();
        printList();
        abone();
    }

    function save() {
        var str = NGIDs.join(',');
        if(typeof GM_setValue == 'function'){
            GM_setValue("NGIDs", str);
            GM_setValue("AboneMode", AboneMode);
        }else{
            localStorage.setItem("NGIDs", str);
            localStorage.setItem("AboneMode", AboneMode);
        }
        saveNGWords();
    }

    function load() {
        var str;
        if(typeof GM_getValue == 'function'){
            str = GM_getValue("NGIDs","");
            if(str == "" || str == null || typeof str == 'undefined') {
                NGIDs = [];
            } else {
                NGIDs = str.split(',');
            }
            AboneMode = GM_getValue("AboneMode","normal");
        }else{
            str = localStorage.getItem("NGIDs","");
            if(str == "" || str == null || typeof str == 'undefined') {
                NGIDs = [];
            } else {
                NGIDs = str.split(',');
            }
            AboneMode = localStorage.getItem("AboneMode","normal");
        }
    }

    function saveNGWords() {
        var ngwordText = document.querySelector(".js-ngwordtext");
        var ngwords = ngwordText.value.split("\n").filter(function(word){
            return word.trim() !== "";
        });

        var str = ngwords.join(',');
        if(typeof GM_setValue == 'function'){
            GM_setValue("NGWords", str);
        }else{
            localStorage.setItem("NGWords", str);
        }
    }

    function loadNGWords() {
        var str;
        if(typeof GM_getValue == 'function'){
            str = GM_getValue("NGWords","");
        }else{
            str = localStorage.getItem("NGWords","");
        }

        if(str == "" || str == null || typeof str == 'undefined') {
            return "";
        }
        return str.split(',').join("\n");
    }

    function abone() {
        var i=0, j=0, clen, ilen, alen, parent;
        var comments = document.querySelectorAll(".js-abonelinkwrap");
        var aboned = document.querySelectorAll(".js-aboned");
        let comment;

        var ngwords = loadNGWords().split("\n").filter(function(word){
            return word.trim() !== "";
        });

        for(i=0,alen=aboned.length; i<alen; i++) {
            aboned[i].classList.remove("js-aboned");
        }
        for(i=0,clen=comments.length; i<clen; i++) {
            comment = comments[i].parentNode;
            // 複数ID対応: data-userids(カンマ区切り)のどれかがNGIDに一致したら非表示。
            // 旧data-useridしか無い場合のフォールバックも兼ねる。
            var cidRaw = comment.dataset.userids;
            var cids = (typeof cidRaw === "string" && cidRaw !== "")
                        ? cidRaw.split(",")
                        : [comment.dataset.userid];
            for(j=0,ilen=NGIDs.length; j<ilen; j++) {
                if(cids.indexOf(NGIDs[j]) !== -1) {
                    if( ! comment.nextElementSibling ) {
                        comment.parentNode.classList.add("js-aboned","js-notree");
                    }else{
                        comment.parentNode.classList.add("js-aboned");
                    }
                }
            }

            for(j=0,ilen=ngwords.length; j<ilen; j++) {
                if(comment.textContent.includes(ngwords[j])) {
                    if( ! comment.nextElementSibling ) {
                        comment.parentNode.classList.add("js-aboned","js-notree");
                    }else{
                        comment.parentNode.classList.add("js-aboned");
                    }
                    break;
                }
            }
        }
    }

    // [pcrt] コメント欄を差し替えたあとに再初期化するための入口。
    // 新しく描画された <ul> を渡すと、その中だけを初期化して
    // IDリンク・あぼーん判定を有効にする。
    window.wikiruInitComments = function(scope) {
        try { initComments(scope); } catch(e) {}
    };

    initStyle();
    initComments();
    initList();
    initBodyClick();
    initSwipe();

    function initSwipe() {
        var container = document.querySelector('.js-listcontainer');
        var drawer    = document.querySelector('.js-drawer');
        if (!container || !drawer) return;

        var startX    = 0;
        var startY    = 0;
        var dragging  = false;
        var dirLocked = false; // 縦/横の方向を最初の動きで確定するフラグ
        var isOpen    = false;
        var THRESHOLD = 80;   // 開閉確定に必要なスワイプ距離(px)
        var EDGE      = 20;   // 画面右端から何px以内をスワイプ開始と見なすか

        function onTouchStart(e) {
            var t = e.touches[0];
            // 閉じている時: .js-drawerタブ上 or 画面右端20px以内のみ反応
            // 開いている時: コンテナ内のみ反応（閉じる方向）
            var fromDrawer    = drawer.contains(e.target);
            var fromEdge      = !isOpen && t.clientX > window.innerWidth - EDGE;
            var fromContainer = isOpen && container.contains(e.target);
            if (!fromDrawer && !fromEdge && !fromContainer) return;

            startX    = t.clientX;
            startY    = t.clientY;
            dragging  = true;
            dirLocked = false;
            container.style.transition = 'none';
        }

        function onTouchMove(e) {
            if (!dragging) return;
            var dx = e.touches[0].clientX - startX;
            var dy = e.touches[0].clientY - startY;

            // 方向未確定: 10px動くまで待つ
            if (!dirLocked) {
                if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return;
                // 縦方向が主体なら即キャンセル（ページスクロールを優先）
                if (Math.abs(dy) >= Math.abs(dx)) {
                    dragging = false;
                    container.style.transition = 'all 0.2s 0s ease-out';
                    container.style.transform  = '';
                    return;
                }
                dirLocked = true; // 横方向確定
            }

            var offset;
            if (isOpen) {
                // 開いている→右スワイプで閉じる方向に追従
                offset = Math.min(300, Math.max(0, dx));
                container.style.transform = 'translateX(' + (-300 + offset) + 'px)';
            } else {
                // 閉じている→左スワイプで開く方向に追従
                offset = Math.min(300, Math.max(0, -dx));
                container.style.transform = 'translateX(' + (-offset) + 'px)';
            }
        }

        function onTouchEnd(e) {
            if (!dragging) return;
            dragging  = false;
            dirLocked = false;
            container.style.transition = 'all 0.2s 0s ease-out';
            var dx = e.changedTouches[0].clientX - startX;
            if (!isOpen && dx < -THRESHOLD) {
                isOpen = true;
                container.classList.add('js-open');
            } else if (isOpen && dx > THRESHOLD) {
                isOpen = false;
                container.classList.remove('js-open');
            }
            // インラインtransformを消してCSSクラスに委ねる
            container.style.transform = '';
        }

        document.addEventListener('touchstart', onTouchStart, { passive: true });
        document.addEventListener('touchmove',  onTouchMove,  { passive: true });
        document.addEventListener('touchend',   onTouchEnd,   { passive: true });

        // transitionend でJS側のisOpenをCSSの実際の状態に同期
        // （hover/tapで開いた場合もisOpenが正確になる）
        container.addEventListener('transitionend', function() {
            var currentX = parseFloat(window.getComputedStyle(container).transform.split(',')[4] || '0');
            isOpen = currentX < -10;
        });
    }
})();