                            "<div class='js-listtable js-listtable-ngid'></div>"+
                        "</div>"+
                        "<div class='js-pagination' style='display:none'></div>"+
                    "</div>"+
                    "<div class='js-listpane js-listpane-ngword'>"+
                        "<textarea class='js-ngwordtext' rows='10'></textarea>"+
                    "</div>"+
                "</div>"+
                "<div class='js-drawer'></div>"+
            "</div>";
        document.body.insertAdjacentHTML("afterend", str);

        var ngwordText = document.querySelector(".js-ngwordtext");
        ngwordText.value = loadNGWords();
        ngwordText.addEventListener("input", saveNGWords);

        var tabBtns = document.querySelectorAll(".js-listtabbtn");
        for (var i = 0; i < tabBtns.length; i++) {
            tabBtns[i].addEventListener("click", function(e){
                var target = e.target.dataset.target;
                var panes = document.querySelectorAll(".js-listpane");
                for (var j = 0; j < panes.length; j++) {
                    panes[j].classList.toggle("active", panes[j].classList.contains("js-listpane-" + target));
                }
                var btns = document.querySelectorAll(".js-listtabbtn");
                for (var j = 0; j < btns.length; j++) {
                    btns[j].classList.toggle("active", btns[j].classList.contains("js-listtabbtn-" + target));
                }
            });
        }

        printList();

        var menu = document.querySelector(".js-listpulldown select");
        var options = menu.getElementsByTagName("OPTION");
        for(var i=0,len=options.length; i<len; i++) {
            menu.options[i].selected = (menu.options[i].value == AboneMode);
        }
        setAboneMode(AboneMode);

        menu.addEventListener("change", function() {
            var i =  this.selectedIndex;
            var options = this.getElementsByTagName("OPTION");
