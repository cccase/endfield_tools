/* ============================================================================
   wkr-theme.js  —  wikiru.jp ダークテーマ切り替え
   v1.0

   やっていること：
     1. Cookie に保存された設定を読んで <html data-theme="..."> を付ける
     2. 切り替えボタンを適切な場所に自動で差し込む
     3. 押されたら Cookie を .wikiru.jp ドメインで保存する
        （これにより、どのwikiで切り替えても全wikiに反映される）

   ※ 読み込み時の「白い画面がチラッと光る」現象を防ぐため、
     1. の処理だけは <head> 内にインラインで別途書く必要がある。
     導入手順.md を参照。
   ============================================================================ */
(function () {
  'use strict';

  var COOKIE   = 'wkr_theme';
  var MAX_AGE  = 60 * 60 * 24 * 365; // 1年
  var root     = document.documentElement;

  /* ---------------------------------------------------------------- Cookie */

  function readCookie() {
    var m = document.cookie.match(/(?:^|;\s*)wkr_theme=(dark|light)/);
    return m ? m[1] : null;
  }

  /* Cookie を親ドメイン（.wikiru.jp）に書く。
     これでサブドメインをまたいで設定が引き継がれる。
     ローカル検証時など親ドメインに書けない環境では自動でホスト単体に落とす。 */
  function writeCookie(value) {
    var base = COOKIE + '=' + value + '; path=/; max-age=' + MAX_AGE + '; SameSite=Lax';
    if (location.protocol === 'https:') base += '; Secure';

    var host  = location.hostname;
    var parts = host.split('.');

    // IPアドレスや localhost でなければ、末尾2ラベルを親ドメインとして使う
    if (parts.length >= 2 && !/^\d+$/.test(parts[parts.length - 1])) {
      document.cookie = base + '; domain=.' + parts.slice(-2).join('.');
    }
    // 書けていなければホスト単体で保存し直す
    if (readCookie() !== value) {
      document.cookie = base;
    }
  }

  /* ----------------------------------------------------------------- 適用 */

  function currentTheme() {
    return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
  }

  function applyTheme(theme) {
    root.setAttribute('data-theme', theme);
    updateButtons(theme);
    paintContrast();
  }

  function toggleTheme() {
    var next = currentTheme() === 'dark' ? 'light' : 'dark';
    applyTheme(next);
    writeCookie(next);
  }

  /* ------------------------------------------------------------- ボタン生成 */

  var SUN =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
    'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2' +
    'M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>';

  var MOON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" ' +
    'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>';

  function makeButton(iconOnly) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'wkr-theme-toggle' + (iconOnly ? ' wkr-icon-only' : '');
    b.setAttribute('data-wkr-theme-toggle', '1');
    b.innerHTML = '<span class="wkr-theme-icon"></span>' +
                  '<span class="wkr-theme-label"></span>';
    b.addEventListener('click', function (e) {
      e.preventDefault();
      toggleTheme();
    });
    return b;
  }

  function updateButtons(theme) {
    var dark = (theme === 'dark');
    var list = document.querySelectorAll('[data-wkr-theme-toggle]');
    for (var i = 0; i < list.length; i++) {
      var b = list[i];
      b.querySelector('.wkr-theme-icon').innerHTML = dark ? SUN : MOON;
      b.querySelector('.wkr-theme-label').textContent = dark ? 'ライトモード' : 'ダークモード';
      b.setAttribute('aria-pressed', dark ? 'true' : 'false');
      b.setAttribute('title', dark ? 'ライトモードに戻す' : 'ダークモードにする');
    }
  }

  /* --------------------------------------------------------- ボタンの設置場所
     優先順位：
       1. ページ側に <span id="wkr-theme-slot"></span> があればそこ（手動指定）
       2. SP版：ハンバーガーメニュー内（#pop-menu の #menubar の直前）
       3. PC版：#navigator の末尾
       4. どこにも入らなければ右下に浮かせる
     ------------------------------------------------------------------------ */

  function placeButton() {
    if (document.querySelector('[data-wkr-theme-toggle]')) return; // 二重設置防止

    var slot = document.getElementById('wkr-theme-slot');
    if (slot) { slot.appendChild(makeButton(false)); return; }

    var popMenu = document.getElementById('pop-menu');
    if (popMenu) {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'padding:8px 12px;';
      wrap.appendChild(makeButton(false));
      var menubar = popMenu.querySelector('#menubar');
      if (menubar && menubar.parentNode) {
        menubar.parentNode.insertBefore(wrap, menubar);
      } else {
        popMenu.appendChild(wrap);
      }
      return;
    }

    var nav = document.getElementById('navigator');
    if (nav) {
      nav.appendChild(document.createTextNode(' '));
      nav.appendChild(makeButton(false));
      return;
    }

    var f = makeButton(false);
    f.className += ' wkr-floating';
    document.body.appendChild(f);
  }


  /* ------------------------------------------------------- 背景の明暗を実測する
     #style プラグインは利用者が任意のCSSを書けるため、
       background-color:#FF450080   ← 8桁（透明度つき）
       background-color:rgba(...)
     のような指定が普通に入ってくる。

     半透明の背景は「下に何があるか」で合成結果が変わる。
     同じ #FF450080 でも、白地なら明るい橙、暗い地なら暗いレンガ色になる。
     CSSの属性セレクタは文字列一致しかできないのでこの計算ができず、
     wkr-dark.css のセクション11だけでは文字色を決められない。

     そこで実際に合成後の輝度を測り、濃い文字か明るい文字かを決めて
     data-wkr-bg を振る。配色そのものは wkr-dark.css 側が持つ。 */

  var DARK_TEXT_LUM = 0.0111;   /* #15171C の相対輝度 */
  var LIGHT_TEXT_LUM = 0.7810;  /* #E8EBEF の相対輝度 */

  function parseColor(str) {
    var m = /^rgba?\(([^)]+)\)/.exec(str || '');
    if (!m) return null;
    var v = m[1].split(/[,\s\/]+/).filter(function (x) { return x !== ''; });
    return { r: +v[0], g: +v[1], b: +v[2], a: v.length > 3 ? +v[3] : 1 };
  }

  function relLum(c) {
    var f = function (v) {
      v /= 255;
      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
    };
    return 0.2126 * f(c.r) + 0.7152 * f(c.g) + 0.0722 * f(c.b);
  }

  function ratio(l1, l2) {
    var a = Math.max(l1, l2), b = Math.min(l1, l2);
    return (a + 0.05) / (b + 0.05);
  }

  /* 祖先をさかのぼって不透明な地に当たるまで積み上げ、実際に見えている色を出す */
  function backdrop(el) {
    var stack = [], n = el;
    while (n) {
      var c = parseColor(getComputedStyle(n).backgroundColor);
      if (c && c.a > 0) {
        stack.push(c);
        if (c.a >= 0.999) break;
      }
      n = n.parentElement;
    }
    var base = { r: 34, g: 38, b: 46, a: 1 };   /* 行き着かなかった場合のページ背景 #22262E */
    var out = stack.length && stack[stack.length - 1].a >= 0.999 ? stack.pop() : base;
    for (var i = stack.length - 1; i >= 0; i--) {
      var c = stack[i];
      out = { r: c.r * c.a + out.r * (1 - c.a),
              g: c.g * c.a + out.g * (1 - c.a),
              b: c.b * c.a + out.b * (1 - c.a), a: 1 };
    }
    return out;
  }

  /* 利用者が文字色も指定している場合は触らない（本人が両方管理しているため） */
  function hasOwnTextColor(el) {
    var st = (el.getAttribute('style') || '').toLowerCase();
    return /(^|;)\s*color\s*:/.test(st);
  }


  /* --- 本文に直接書かれた文字色を測って直す ---------------------------------
     &color(); や &tooltip(color=...); では、利用者が任意の色を指定できる。
     wkr-dark.css のセクション11は「よく使われる暗い色」を列挙して置き換えて
     いるが、#D11B00 や #8C4FC9 のような値までは網羅できない。

     ここでは実際に描かれている文字色と、その下の地の色を測り、
     コントラストが足りない場合だけ色相と彩度を保ったまま明度を動かす。
     赤は赤、青は青のまま残るので、利用者がつけた意味は壊れない。 */

  var MIN_TEXT_RATIO = 4.5;

  function rgbToHsl(c) {
    var r = c.r / 255, g = c.g / 255, b = c.b / 255;
    var mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn;
    var h = 0, l = (mx + mn) / 2;
    var s = d === 0 ? 0 : d / (1 - Math.abs(2 * l - 1));
    if (d !== 0) {
      if (mx === r) h = ((g - b) / d) % 6;
      else if (mx === g) h = (b - r) / d + 2;
      else h = (r - g) / d + 4;
      h *= 60; if (h < 0) h += 360;
    }
    return { h: h, s: s, l: l };
  }

  function hslToRgb(o) {
    var c = (1 - Math.abs(2 * o.l - 1)) * o.s;
    var x = c * (1 - Math.abs(((o.h / 60) % 2) - 1));
    var m = o.l - c / 2, r, g, b;
    var seg = Math.floor(o.h / 60) % 6;
    if (seg === 0) { r = c; g = x; b = 0; }
    else if (seg === 1) { r = x; g = c; b = 0; }
    else if (seg === 2) { r = 0; g = c; b = x; }
    else if (seg === 3) { r = 0; g = x; b = c; }
    else if (seg === 4) { r = x; g = 0; b = c; }
    else { r = c; g = 0; b = x; }
    return { r: Math.round((r + m) * 255), g: Math.round((g + m) * 255),
             b: Math.round((b + m) * 255), a: 1 };
  }

  /* 地より明るくする方向へ寄せるか、暗くする方向へ寄せるかを決めて動かす */
  function fitToBackdrop(fg, bgLum) {
    var hsl = rgbToHsl(fg);
    var up = bgLum < 0.18;                  /* 暗い地なら明るく、明るい地なら暗く */
    for (var i = 0; i < 60; i++) {
      var cand = hslToRgb(hsl);
      if (ratio(relLum(cand), bgLum) >= MIN_TEXT_RATIO) return cand;
      hsl.l += up ? 0.015 : -0.015;
      if (hsl.l > 1 || hsl.l < 0) break;
    }
    return hslToRgb({ h: hsl.h, s: hsl.s, l: up ? 0.9 : 0.12 });
  }

  function hasInlineTextColor(el) {
    return /(^|;)\s*color\s*:/.test((el.getAttribute('style') || '').toLowerCase());
  }

  /* 地の指定があるか。
     style属性の文字列だけを見てはいけない。
     background: #white のように書き間違えた指定は CSS として不正なので
     ブラウザに捨てられ、実際には地が無い状態になる。
     「書いてあるか」ではなく「実際に描かれているか」で判断する。 */
  function hasInlineBg(el) {
    return /background/.test((el.getAttribute('style') || '').toLowerCase());
  }
  function renderedBg(el) {
    var c = parseColor(getComputedStyle(el).backgroundColor);
    return (c && c.a > 0) ? c : null;
  }
  function hasBgAncestor(el, scope) {
    var n = el.parentElement;
    while (n && n !== scope.parentElement) {
      /* 祖先は「作者がインラインで指定し、かつ実際に描かれている」ものだけ数える。
         表のセルのようにクラス由来の地まで数えると、
         ネタバレ用の白文字が隠せなくなる。 */
      if (hasInlineBg(n) && renderedBg(n)) return true;
      n = n.parentElement;
    }
    return false;
  }
  function hasRenderedBgDescendant(el) {
    var ds = el.querySelectorAll('[style*="background"]');
    for (var k = 0; k < ds.length; k++) {
      if (renderedBg(ds[k])) return true;
    }
    return false;
  }

  var WHITE_LUM = 0.85;   /* これ以上明るい文字色は「白」とみなす */

  function paintInlineColors(scope) {
    var els = scope.querySelectorAll('[style*="color"]');
    for (var i = 0; i < els.length; i++) {
      var el = els[i];
      if (!hasInlineTextColor(el)) continue;

      /* 作者が地も指定している場合は何もしない。
         &color(#ffffff){&color(,#ff00ff){毒};}; のようなバッジは
         白文字とマゼンタ地の組み合わせで完成しているので、
         コントラストが低くても触るべきではない。
         ただし判定は「実際に描かれている地」で行う。 */
      if (renderedBg(el) || hasRenderedBgDescendant(el)) continue;

      var fg = parseColor(getComputedStyle(el).color);
      if (!fg) continue;
      var bg = backdrop(el);
      var bgLum = relLum(bg);

      /* ネタバレ用の白文字。
         wikiruでは「白背景に白文字」で伏せる書き方が定着している。
         暗い側ではそのままだと丸見えになるので、地と同じ色に置き換えて
         ライトのときと同じ「読めないが選択すれば読める」状態に戻す。

         地の指定が祖先にもない＝素のページやセルの上に置かれている、
         という条件を付けているので、#style の色付きカードの上に
         意図して置かれた白文字までは隠さない。 */
      if (relLum(fg) >= WHITE_LUM && !hasBgAncestor(el, scope)) {
        if (!el.hasAttribute('data-wkr-c0')) {
          el.setAttribute('data-wkr-c0', el.style.color || '');
        }
        el.style.setProperty('color',
          'rgb(' + Math.round(bg.r) + ',' + Math.round(bg.g) + ',' + Math.round(bg.b) + ')',
          'important');
        continue;
      }

      if (ratio(relLum(fg), bgLum) >= MIN_TEXT_RATIO) continue;
      if (!el.hasAttribute('data-wkr-c0')) {
        el.setAttribute('data-wkr-c0', el.style.color || '');
      }
      var fixed = fitToBackdrop(fg, bgLum);
      el.style.setProperty('color',
        'rgb(' + fixed.r + ',' + fixed.g + ',' + fixed.b + ')', 'important');
    }
  }

  function restoreInlineColors() {
    var els = document.querySelectorAll('[data-wkr-c0]');
    for (var i = 0; i < els.length; i++) {
      els[i].style.removeProperty('color');
      var v = els[i].getAttribute('data-wkr-c0');
      if (v) els[i].style.color = v;
      els[i].removeAttribute('data-wkr-c0');
    }
  }

  function paintContrast() {
    if (currentTheme() !== 'dark') {
      restoreInlineColors();
      var old = document.querySelectorAll('[data-wkr-bg],[data-wkr-a]');
      for (var k = 0; k < old.length; k++) {
        old[k].removeAttribute('data-wkr-bg');
        old[k].removeAttribute('data-wkr-a');
      }
      return;
    }
    /* 走査は複数回走る（初期化時・load時・切り替え時）。
       前回こちらが書き換えた色を残したまま測ると、
       「補正後の色」をさらに補正してしまい値がずれていく。
       まず作者が書いた値へ戻してから測り直す。 */
    restoreInlineColors();

    var roots = ['#body', '#menubar', '#note'], list = [];
    for (var r = 0; r < roots.length; r++) {
      var host = document.querySelector(roots[r]);
      if (host) list = list.concat([].slice.call(
        host.querySelectorAll('[style*="background"]')));
    }
    for (var i = 0; i < list.length; i++) {
      var el = list[i];
      if (hasOwnTextColor(el)) { el.removeAttribute('data-wkr-bg'); continue; }
      var own = parseColor(getComputedStyle(el).backgroundColor);
      if (!own || own.a === 0) { el.removeAttribute('data-wkr-bg'); continue; }
      var lum = relLum(backdrop(el));
      var withDark = ratio(lum, DARK_TEXT_LUM);
      var withLight = ratio(lum, LIGHT_TEXT_LUM);
      el.setAttribute('data-wkr-bg', withDark >= withLight ? 'light' : 'dark');
    }

    /* --- クラスで明るい背景を敷いているプラグインを拾う ---------------------
       プラグインの多くは <style> で .foo{background:#f7f9fc} のように
       クラスで地を敷き、その上の文字色は「本文から降ってくる黒」を当てにしている。
       ダークでは本文の文字色が明るいので、明るい地に明るい文字が乗って消える。
       インラインstyleではないので上の走査には掛からない。

       そこで #body 以下を一通り見て、実際に明るい地になっている要素に印を付ける。
       文字色は継承で降りるだけなので、自前で色を持っている子要素はそのまま残る。 */
    /* しきい値は 0.5。狙いは「プラグインが白系の地を敷いたまま文字色を
       本文任せにしている」ケースで、そこは相対輝度0.8以上に集まる。
       0.22 だと表の罫線色（#808DA3 / 0.263）まで拾ってしまい、
       表の中の全リンクに印が付いて、未作成リンクの色まで巻き込んでいた。 */
    var LIGHT_SURFACE = 0.5;
    for (var q = 0; q < roots.length; q++) {
      var scope = document.querySelector(roots[q]);
      if (!scope) continue;
      var all = scope.getElementsByTagName('*');
      for (var t = 0; t < all.length; t++) {
        var e = all[t];
        if (e.hasAttribute('data-wkr-bg')) continue;
        var bc = parseColor(getComputedStyle(e).backgroundColor);
        if (!bc || bc.a < 0.85) continue;
        if (relLum(bc) < LIGHT_SURFACE) continue;
        /* 作者が地と文字色の両方を指定していて、その組み合わせで
           すでに読める場合は印を付けない。
           付けてしまうと文字色をこちらの濃色で上書きしてしまい、
           意図した配色（淡い地に茶色の文字、など）が消える。
           子孫は作者の色を継承するので、そのままで問題ない。 */
        if (hasInlineTextColor(e)) {
          var ownFg = parseColor(getComputedStyle(e).color);
          if (ownFg && ratio(relLum(ownFg), relLum(bc)) >= MIN_TEXT_RATIO) continue;
        }
        e.setAttribute('data-wkr-bg', 'light');
        list.push(e);
      }
    }

    /* リンクは個別に測り直す。
       #style の枠の中に表が入ると、枠は明るいのにセルは暗い、という入れ子になる。
       枠を基準に子孫のリンクをまとめて塗ると、暗いセルの中のリンクが
       濃い青のまま残って読めなくなる。リンク自身の地を見ること。 */
    var links = [];
    for (var m = 0; m < list.length; m++) {
      if (list[m].hasAttribute('data-wkr-bg')) {
        links = links.concat([].slice.call(list[m].getElementsByTagName('a')));
      }
    }
    for (var q2 = 0; q2 < roots.length; q2++) {
      var sc = document.querySelector(roots[q2]);
      if (sc) paintInlineColors(sc);
    }

    for (var j = 0; j < links.length; j++) {
      var a = links[j];
      /* 未作成リンクにも印は付ける。ここで飛ばすと CSS 側の
         span.noexists a[data-wkr-a] が一致しなくなり、かえって
         枠を基準にした汎用ルールに負ける。色の出し分けは CSS が持つ。 */
      var alum = relLum(backdrop(a));
      a.setAttribute('data-wkr-a',
        ratio(alum, DARK_TEXT_LUM) >= ratio(alum, LIGHT_TEXT_LUM) ? 'light' : 'dark');
    }
  }

  /* ------------------------------------------------------------------ 起動 */

  function init() {
    // <head> のインラインスクリプトが動いていなかった場合の保険
    if (!root.getAttribute('data-theme')) {
      root.setAttribute('data-theme', readCookie() || 'light');
    }
    placeButton();
    updateButtons(currentTheme());
    paintContrast();
    /* プラグインが遅れて描画する箇所があるため、読み込み完了後にもう一度走らせる */
    window.addEventListener('load', paintContrast);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // 他のスクリプトから呼べるように公開しておく
  window.wkrTheme = {
    version: '1.7 (2026-09-02)',
    get: currentTheme,
    set: function (t) { t = (t === 'dark' ? 'dark' : 'light'); applyTheme(t); writeCookie(t); },
    toggle: toggleTheme,
    repaint: paintContrast
  };
})();
