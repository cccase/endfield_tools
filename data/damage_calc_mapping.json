{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Damage Calculation Parameter to Calculation Group Mapping",
  "version": "1.0.0",
  "source": "https://arknights-endfield.wikiru.jp/?%E3%83%80%E3%83%A1%E3%83%BC%E3%82%B8%E8%A8%88%E7%AE%97%E5%BC%8F",
  "calculationGroups": [
    {
      "id": "reference_scale",
      "name": "参照スケール（攻撃力）",
      "type": "scaling",
      "formula": "((charBaseAtk + weaponBaseAtk) * (1 + sum(atkPercent)) + flatAtk) * (1 + mainStat * 0.005 + subStat * 0.002)",
      "additiveWithinGroup": true,
      "description": "基礎攻撃力に攻撃力%の総和を乗算し、能力値付加を乗算した最終攻撃力"
    },
    {
      "id": "skill_multiplier",
      "name": "ダメージ倍率補正",
      "type": "multiplier",
      "formula": "skillMultiplierPercent",
      "additiveWithinGroup": false,
      "description": "スキルのモーション倍率%"
    },
    {
      "id": "damage_up",
      "name": "ダメージUP補正",
      "type": "additive_modifier",
      "formula": "1 + sum(damageUpRates)",
      "additiveWithinGroup": true,
      "description": "属性ダメージUP、スキル種別ダメージUP、全スキルダメージUP、与ダメバフをすべて同枠加算"
    },
    {
      "id": "amplification",
      "name": "増幅補正",
      "type": "additive_modifier",
      "formula": "1 + sum(ampRates)",
      "additiveWithinGroup": true,
      "description": "属性増幅およびアーツ増幅を同枠加算"
    },
    {
      "id": "taken_damage_up",
      "name": "被ダメージ補正",
      "type": "additive_modifier",
      "formula": "1 + sum(takenDamageUpRates)",
      "additiveWithinGroup": true,
      "description": "敵の受けるダメージUP、破砕(物理被ダメUP)、感電(アーツ被ダメUP)を同枠加算"
    },
    {
      "id": "vulnerability",
      "name": "脆弱補正",
      "type": "additive_modifier",
      "formula": "1 + sum(vulnRates)",
      "additiveWithinGroup": true,
      "description": "物理脆弱、アーツ脆弱を同枠加算"
    },
    {
      "id": "resistance",
      "name": "耐性補正",
      "type": "mitigation",
      "formula": "1 - (baseRes - resShred - resIgnore) / 100",
      "additiveWithinGroup": true,
      "description": "敵耐性から腐食による耐性ダウン等を減算した耐性減衰"
    },
    {
      "id": "defense",
      "name": "防御補正",
      "type": "mitigation",
      "formula": "100 / (100 + enemyDefense)",
      "additiveWithinGroup": false,
      "description": "敵防御力による減衰"
    },
    {
      "id": "critical",
      "name": "会心補正",
      "type": "expected_multiplier",
      "formula": "1 + critRate * critDamage",
      "additiveWithinGroup": true,
      "description": "会心率と会心ダメージによる期待値または発生時倍率"
    },
    {
      "id": "break",
      "name": "ブレイク補正",
      "type": "multiplier",
      "formula": "isBroken ? 1.3 : 1.0",
      "additiveWithinGroup": false,
      "description": "敵ブレイク時の1.3倍補正"
    }
  ],
  "parameterMappings": [
    { "category": "armor", "parameterName": "防具の基礎能力値", "calcGroupId": "reference_scale", "target": "ability_stats" },
    { "category": "armor", "parameterName": "防具の攻撃力%", "calcGroupId": "reference_scale", "target": "atk_percent" },
    { "category": "armor", "parameterName": "防具のダメージUP効果", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "armor", "parameterName": "防具の会心率", "calcGroupId": "critical", "target": "crit_rate" },
    { "category": "armor", "parameterName": "防具のセット効果（与ダメ）", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "armor", "parameterName": "防具のセット効果（増幅）", "calcGroupId": "amplification", "target": "amp" },
    { "category": "armor", "parameterName": "防具のセット効果（攻撃力）", "calcGroupId": "reference_scale", "target": "atk_percent" },
    { "category": "weapon", "parameterName": "武器の基礎攻撃力", "calcGroupId": "reference_scale", "target": "base_atk" },
    { "category": "weapon", "parameterName": "武器のスキル1（能力値）", "calcGroupId": "reference_scale", "target": "ability_stats" },
    { "category": "weapon", "parameterName": "武器のスキル2（属性ダメージ）", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "weapon", "parameterName": "武器のスキル3（攻撃力%）", "calcGroupId": "reference_scale", "target": "atk_percent" },
    { "category": "weapon", "parameterName": "武器のスキル3（ダメージUP）", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "weapon", "parameterName": "武器のスキル3（被ダメージUP）", "calcGroupId": "taken_damage_up", "target": "taken_damage_up" },
    { "category": "character", "parameterName": "オペレーターの基礎攻撃力", "calcGroupId": "reference_scale", "target": "base_atk" },
    { "category": "character", "parameterName": "オペレーターの基礎能力値", "calcGroupId": "reference_scale", "target": "ability_stats" },
    { "category": "character", "parameterName": "オペレーターの主・副能力設定", "calcGroupId": "reference_scale", "target": "ability_mult" },
    { "category": "character", "parameterName": "スキルのダメージ倍率", "calcGroupId": "skill_multiplier", "target": "skill_multiplier" },
    { "category": "character", "parameterName": "素質効果（ダメージUP）", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "character", "parameterName": "素質効果（被ダメージUP）", "calcGroupId": "taken_damage_up", "target": "taken_damage_up" },
    { "category": "timeline", "parameterName": "全体攻撃力バフ", "calcGroupId": "reference_scale", "target": "atk_percent" },
    { "category": "timeline", "parameterName": "単体攻撃力バフ / 自己攻撃力バフ", "calcGroupId": "reference_scale", "target": "atk_percent" },
    { "category": "timeline", "parameterName": "全体増幅バフ", "calcGroupId": "amplification", "target": "amp" },
    { "category": "timeline", "parameterName": "全体ダメージUPバフ", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "timeline", "parameterName": "単体ダメージUPバフ", "calcGroupId": "damage_up", "target": "damage_up" },
    { "category": "timeline", "parameterName": "敵被ダメージUPデバフ", "calcGroupId": "taken_damage_up", "target": "taken_damage_up" },
    { "category": "timeline", "parameterName": "敵脆弱デバフ", "calcGroupId": "vulnerability", "target": "vuln" },
    { "category": "timeline", "parameterName": "破砕（クラッシュ消費）", "calcGroupId": "taken_damage_up", "target": "taken_damage_up" },
    { "category": "timeline", "parameterName": "感電（アーツ異常）", "calcGroupId": "taken_damage_up", "target": "taken_damage_up" },
    { "category": "timeline", "parameterName": "腐食（アーツ異常）", "calcGroupId": "resistance", "target": "res_shred" },
    { "category": "enemy", "parameterName": "敵の基礎防御力", "calcGroupId": "defense", "target": "defense" },
    { "category": "enemy", "parameterName": "敵の基礎耐性値", "calcGroupId": "resistance", "target": "res" },
    { "category": "enemy", "parameterName": "敵のブレイク状態", "calcGroupId": "break", "target": "break" }
  ]
}
